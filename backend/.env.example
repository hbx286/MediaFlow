# 复制后由 shell 或部署环境加载；程序仅从环境变量读取配置。
# PostgreSQL 连接地址；此处仅为本地示例，使用前请替换账号、密码和数据库名。
DATABASE_URL=postgres://mediaflow:change-me@localhost:5432/mediaflow?sslmode=disable
# HTTP 服务监听地址；省略主机名表示监听所有网络接口。
HTTP_ADDR=:8080
# 读取 HTTP 请求头的最长时间。
HTTP_READ_HEADER_TIMEOUT=5s
# 读取完整 HTTP 请求的最长时间。
HTTP_READ_TIMEOUT=10s
# 写入 HTTP 响应的最长时间。
HTTP_WRITE_TIMEOUT=15s
# 空闲 HTTP 连接保持的最长时间。
HTTP_IDLE_TIMEOUT=60s
# 等待在途 HTTP 请求完成的最长时间；不限制连接池关闭耗时。
SHUTDOWN_TIMEOUT=10s
# 建立单个 PostgreSQL 连接的最长时间。
DB_CONNECT_TIMEOUT=5s
# 就绪检查执行 PostgreSQL Ping 的最长时间。
DB_PING_TIMEOUT=2s
# PostgreSQL 连接池允许的最大连接数。
DB_MAX_CONNS=10
# PostgreSQL 连接池期望维持的最小连接数；短时间内可能低于此值。
DB_MIN_CONNS=1
# 超过最小连接数时，空闲连接在连接池中的最长保留时间。
DB_MAX_CONN_IDLE_TIME=30m
# 连接池检查连接健康状态的间隔。
DB_HEALTH_CHECK_PERIOD=1m
